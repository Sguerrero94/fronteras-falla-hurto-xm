# Copia este archivo como .env y pega la cadena de Supabase:
# Project Settings > Database > Connection string > Session pooler.
# Si la contraseña tiene caracteres especiales, escríbela codificada (@ = %40).
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres
